# Xiaomi garnet (SM7435 / kera, 4 KiB pages) device fragment.
# Only device-specific options are listed here; root and hiding features
# from the community tree (KSU, SUSFS, NOMOUNT) are excluded. LOCALVERSION is
# set here because this fragment is the last one applied by the device tree.
CONFIG_LOCALVERSION="-ZairenOX-Oz1B"

# Garnet Unified Memory Management (UMM) and CPU scheduling. These options are
# also present in consolidate.fragment and vendor/kera_le.config for the other
# build paths; the LineageOS device tree uses this fragment.
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSMALLOC=y
CONFIG_DMABUF_SYSFS_STATS=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y

# Battery and fuel gauge: QTI charger firmware over PMIC Glink, TI BQ gauge
CONFIG_QTI_PMIC_GLINK=m
CONFIG_QTI_PMIC_GLINK_DEBUG=m
CONFIG_QTI_BATTERY_GLINK_DEBUG=m
CONFIG_QTI_CHARGER_ULOG_GLINK=m
CONFIG_QTI_BATTERY_CHARGER=m
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_BQ_FG_UPDATE=y

# Fingerprint / under-display optical sensors
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC_FOD=m
CONFIG_FINGERPRINT_GOODIX_FOD_G3S=m

# Haptics (QTI HV vibrator on PMIC)
CONFIG_INPUT_QCOM_HV_HAPTICS=m

# N16 camera/AMOLED regulator
CONFIG_REGULATOR_WL2866D_N16=m

# Hardware ID: selects region-specific Wi-Fi board data
CONFIG_MI_HARDWARE_ID=m

# MTD and crash dump partitions
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m

# Thermal: interface used by mi_thermald
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y
CONFIG_HAVE_CHARGE_TEMP=y

# Present on the 5.10 garnet kernel
CONFIG_DEVTMPFS=y

# Netfilter match used by Xiaomi tethering rules
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y

# Remote controller / IR blaster
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=m
CONFIG_LIRC=y

# Netfilter TTL/HL and ipset, used by tethering and firewall rules
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Overlayfs and tmpfs xattr, needed by Android userspace
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y

# KernelSU-Next + SUSFS
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
